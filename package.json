{
  "name": "pos-pasteleria",
  "private": true,
  "version": "0.1.0",
  "description": "Sistema POS local-first para pastelería. Ver AGENT.md antes de modificar.",
  "scripts": {
    "dev": "pnpm --filter @pos/desktop dev & pnpm --filter @pos/desktop dev:electron",
    "dev:vite": "pnpm --filter @pos/desktop dev",
    "dev:electron": "pnpm --filter @pos/desktop dev:electron",
    "db:generate": "pnpm --filter @pos/db drizzle-kit generate",
    "db:migrate": "pnpm --filter @pos/db drizzle-kit migrate",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
